      "position": [
        660,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "domain",
              "value": "={{ $json.domain }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "monthlyVisits",
              "value": "={{ $json.visits.estimatedMonthlyVisits }}",
              "type": "number"
            },
            {
              "id": "a3",
              "name": "globalRank",
              "value": "={{ $json.ranks.global }}",
              "type": "number"
            },
            {
              "id": "a4",
              "name": "aiVisits",
