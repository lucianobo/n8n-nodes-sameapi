        440,
        0
      ],
      "parameters": {
        "resource": "domain",
        "operation": "getTraffic",
        "domain": "={{ $json.domain }}",
        "simplify": true
      }
    },
    {
      "id": "c8dd043a-6e77-4ec6-8c2c-d4ac2cc5c1b7",
      "name": "Pick fields",
      "type": "n8n-nodes-base.set",
