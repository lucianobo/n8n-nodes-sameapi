        0
      ],
      "parameters": {
        "jsCode": "return ['example.com', 'github.com', 'wikipedia.org'].map((domain) => ({ json: { domain } }));"
      }
    },
    {
      "id": "63002a62-ced7-4cc6-b049-f9fa6e7c0995",
